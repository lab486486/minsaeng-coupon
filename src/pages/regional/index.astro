---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { grantTierFromAmount } from '../../lib/grants';
import { getPublishedRegionalGrants } from '../../lib/regional';

const grants = await getPublishedRegionalGrants();
---

<BaseLayout
  title="지역지원금 정보"
  description="최신 뉴스를 기반으로 작성한 지역지원금 안내 정보"
  path="/regional/"
>
  <section class="section" style="padding-top: 2.5rem;">
    <div class="container">
      <div class="section__head">
        <div>
          <h2>지역지원금 정보</h2>
          <p>최신 뉴스를 기반으로 작성한 지역지원금 안내 정보</p>
        </div>
        <a href="/news/">뉴스 보기 →</a>
      </div>

      <div class="post-list">
        {
          grants.length === 0 ? (
            <p class="notice">게시된 지역지원금 정보가 없습니다.</p>
          ) : (
            grants.map((grant) => {
              const tier = grantTierFromAmount(grant.data.amount);
              return (
                <a class="post-row" href={`/regional/${grant.id}/`}>
                  <div class="post-row__meta">
                    <span class={`chip chip--tier chip--tier-${tier}`}>{grant.data.amount}</span>
                    <span class="chip chip--teal">{grant.data.region}</span>
                    <span class="chip">{grant.data.verifiedAt}</span>
                  </div>
                  <h3>{grant.data.title}</h3>
                  <p>{grant.data.target}</p>
                </a>
              );
            })
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
